APP_NAME="AIO Invoice"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.aio-mauzo.local

FRONTEND_URL=http://app.aio-mauzo.local

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aio_mauzo
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared parent domain so the Sanctum session cookie is visible across both
# the api.* and app.* subdomains — see SANCTUM_STATEFUL_DOMAINS below.
SESSION_DOMAIN=.aio-mauzo.local

# Every host the SPA frontend may be served from (comma-separated, no scheme).
SANCTUM_STATEFUL_DOMAINS=app.aio-mauzo.local,app.aio-mauzo.local:3000,localhost:3000,127.0.0.1:3000

# Every origin the SPA frontend may be served from (comma-separated, with scheme).
CORS_ALLOWED_ORIGINS=http://app.aio-mauzo.local,http://app.aio-mauzo.local:3000,http://localhost:3000,http://127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Invoice-Generator.com API integration
# https://invoice-generator.com/developers
# NEVER expose this key to the frontend — all requests are proxied server-side
# via App\Services\InvoiceGeneratorService.
INVOICE_GENERATOR_API_KEY=
INVOICE_GENERATOR_API_URL=https://invoice-generator.com
